# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- docker-compose: Postgres ---
POSTGRES_PASSWORD=
NETRA_RO_PASSWORD=

# --- docker-compose: MongoDB ---
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- apps/api ---
PORT=
# Connection string using the netra_ro role (see db/init/01-readonly-role.sql).
DATABASE_URL=
MONGODB_URL=
# 'fixture' bypasses all Azure Speech calls — the default and the public demo mode.
# 'live' requires AZURE_SPEECH_KEY and AZURE_SPEECH_REGION; the app refuses to start without them.
NETRA_TTS_MODE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Where synthesised speech is cached, so replaying a sentence never bills twice.
# Relative paths resolve from the repo root. Optional; defaults to .cache/tts
NETRA_TTS_CACHE_DIR=
# Azure neural TTS list price per million characters, for the daily spend counter.
# Optional; defaults to 16 — verify against current Azure pricing.
NETRA_TTS_USD_PER_MILLION_CHARS=
# Browser origin allowed to call the API. Optional; defaults to http://localhost:5173
NETRA_WEB_ORIGIN=

# --- apps/web ---
VITE_API_BASE_URL=
