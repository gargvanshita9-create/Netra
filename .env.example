# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- docker-compose: Postgres ---
POSTGRES_PASSWORD=
NETRA_RO_PASSWORD=

# --- docker-compose: MongoDB ---
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- apps/api ---
PORT=
# Connection string using the netra_ro role (see db/init/01-readonly-role.sql).
DATABASE_URL=
MONGODB_URL=
# 'fixture' bypasses all Azure Speech calls — the default and the public demo mode.
NETRA_TTS_MODE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- apps/web ---
VITE_API_BASE_URL=
