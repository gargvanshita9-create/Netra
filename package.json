{
  "name": "netra",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "pnpm -r lint && eslint scripts --max-warnings 0",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "inspect-glb": "tsx scripts/inspect-glb.ts",
    "seed:generate": "tsx scripts/generate-seed-data.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
